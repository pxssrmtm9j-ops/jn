<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Premium Local Business</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; color: #111; background: #fff; }
    h1,h2,h3 { font-family: 'Playfair Display', serif; }
    a { text-decoration: none; }

    .container { max-width: 1100px; margin: auto; padding: 20px; }

    header {
      position: fixed; width: 100%; top: 0; background: rgba(255,255,255,0.9);
      backdrop-filter: blur(10px); z-index: 1000;
    }
    nav { display: flex; justify-content: space-between; align-items: center; }
    nav a { margin-left: 20px; color: #111; font-weight: 500; }

    .hero {
      height: 100vh; display: flex; align-items: center; text-align: center;
      background: linear-gradient(to bottom, #f8f8f8, #fff);
      padding-top: 80px;
    }
    .hero h1 { font-size: 2.8rem; margin-bottom: 20px; }
    .hero p { color: #555; margin-bottom: 30px; }
    .btn {
      padding: 14px 28px; border: 1px solid #111; color: #111;
      transition: 0.3s;
    }
    .btn:hover { background: #111; color: #fff; }

    section { padding: 80px 0; }

    .services { display: grid; gap: 20px; }
    .card {
      padding: 30px; border: 1px solid #eee; transition: 0.3s;
    }
    .card:hover { transform: translateY(-5px); }

    .testimonials { background: #fafafa; }
    .testimonial { margin-bottom: 20px; }

    .about { display: grid; gap: 20px; }

    .contact form { display: grid; gap: 15px; }
    input, textarea {
      padding: 12px; border: 1px solid #ddd; width: 100%;
    }

    footer { text-align: center; padding: 40px 0; font-size: 0.9rem; color: #666; }

    @media(min-width:768px){
      .services { grid-template-columns: repeat(3,1fr); }
      .about { grid-template-columns: 1fr 1fr; align-items: center; }
    }
  </style>
</head>
<body>

<header>
  <div class="container">
    <nav>
      <h3>BrandName</h3>
      <div>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
  </div>
</header>

<section class="hero">
  <div class="container">
    <h1>Elevate Your Experience with Premium Service</h1>
    <p>Modern, refined solutions designed to deliver results and build trust.</p>
    <a href="#contact" class="btn">Book a Consultation</a>
  </div>
</section>

<section id="services">
  <div class="container">
    <h2>Our Services</h2>
    <div class="services">
      <div class="card">
        <h3>Service One</h3>
        <p>High-quality service tailored to your needs.</p>
      </div>
      <div class="card">
        <h3>Service Two</h3>
        <p>Expert solutions with measurable results.</p>
      </div>
      <div class="card">
        <h3>Service Three</h3>
        <p>Reliable, efficient, and premium experience.</p>
      </div>
    </div>
  </div>
</section>

<section class="testimonials">
  <div class="container">
    <h2>What Clients Say</h2>
    <div class="testimonial">“Absolutely outstanding service. Highly recommend.”</div>
    <div class="testimonial">“Professional, efficient, and exceeded expectations.”</div>
  </div>
</section>

<section id="about" class="about container">
  <div>
    <h2>About Us</h2>
    <p>We are dedicated to delivering premium services with a human touch. Our focus is on trust, quality, and long-term relationships.</p>
  </div>
  <div>
    <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d" alt="team" style="width:100%; border-radius:10px;">
  </div>
</section>

<section id="contact" class="contact">
  <div class="container">
    <h2>Book or Contact Us</h2>
    <form>
      <input type="text" placeholder="Your Name" required>
      <input type="email" placeholder="Your Email" required>
      <textarea rows="5" placeholder="Your Message"></textarea>
      <button class="btn">Send Message</button>
    </form>
  </div>
</section>

<footer>
  <p>© 2026 BrandName. All rights reserved.</p>
</footer>

<script>
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      document.querySelector(this.getAttribute('href')).scrollIntoView({
        behavior: 'smooth'
      });
    });
  });
</script>

</body>
</html>
